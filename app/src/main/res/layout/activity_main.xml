<?xml version="1.0" encoding="utf-8"?>
<!-- 全屏扩展屏：解码画面 + 鼠标光标叠加层 + 隐藏菜单 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <SurfaceView
        android:id="@+id/surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 鼠标光标叠加层：盖在画面上方，自己不接收触摸（见 CursorOverlay.init） -->
    <org.opendisplay.legacy.CursorOverlay
        android:id="@+id/cursor_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 隐藏菜单：三指轻点屏幕唤出；显示连接状态 + 退出 + 关闭 -->
    <LinearLayout
        android:id="@+id/menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#CC000000"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/menu_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:paddingBottom="12dp" />

        <Button
            android:id="@+id/btn_exit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/exit" />

        <Button
            android:id="@+id/btn_close_menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/close" />
    </LinearLayout>

</FrameLayout>
